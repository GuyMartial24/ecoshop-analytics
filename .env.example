# --- Entrepôt de données (warehouse) ---
WAREHOUSE_USER=ecoshop
WAREHOUSE_PASSWORD=change_me
WAREHOUSE_DB=ecoshop_dw
# 5433 côté PC pour éviter un conflit avec un autre PostgreSQL local
WAREHOUSE_PORT=5433

# --- Base interne de Lightdash ---
LIGHTDASH_DB_USER=lightdash
LIGHTDASH_DB_PASSWORD=change_me
LIGHTDASH_DB_NAME=lightdash

# --- Lightdash ---
LIGHTDASH_SECRET=change_me_with_a_long_random_string
LIGHTDASH_PORT=8080
SITE_URL=http://localhost:8080

# --- Stockage objet S3 (exigé par Lightdash) ---
S3_BUCKET=lightdash
S3_REGION=us-east-1
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me

# --- Alertes Slack (Incoming Webhook du canal #data-alerts) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/change_me

# --- Airflow (profil "airflow" de docker compose) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow
# 8082 côté PC : 8080 est déjà utilisé par Lightdash
AIRFLOW_PORT=8082

# --- Production uniquement (docker-compose.prod.yml) ---
# IP privée du VPS sur laquelle Lightdash écoute (publiée par le reverse proxy)
LIGHTDASH_BIND_IP=127.0.0.1
# uid de l'utilisateur du serveur (commande : id -u)
AIRFLOW_UID=1000

# --- Lightdash (jeton d'accès personnel pour la CLI) ---
LIGHTDASH_API_KEY=change_me
